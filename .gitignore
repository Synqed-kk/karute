# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright auth storage state — gitignored, regenerated by scripts/playwright-login.ts
.auth/

# E2E test env (contains secrets) and Playwright output artifacts
.env.e2e
test-results/
playwright-report/

# Playwright MCP debug artifacts and ad-hoc screenshots from dev sessions
.playwright-mcp/
record-page-*.png
record-redesign-*.png

# thin target build output (never committed)
thin/dist/
# Android signing secrets — MUST stay out of git on EVERY branch (the android
# branch has its own android/.gitignore, but that file doesn't exist on other
# checkouts while the untracked android/ folder does — root rule closes the gap).
*.jks
*.keystore
android/keystore.properties

# monotonic build-number state (machine-local)
scripts/shell/.last-build-number

# Xcode build cache — 2,494 of these were committed by accident (evicted 7/18)
ios/DerivedData/
# Claude worktree gitlinks must never be committed (dangling-submodule warnings on Xcode Cloud)
.claude/worktrees/
.gstack/
